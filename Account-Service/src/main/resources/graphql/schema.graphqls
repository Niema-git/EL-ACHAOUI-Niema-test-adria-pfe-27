enum AccountStatus { ACTIVE BLOCKED }

type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

input AccountInput {
    customerReference: String!
    currency: String!
    balance: Float!
}

type Query {
    accounts: [Account]
    accountById(id: ID!): Account
    accountsByCustomer(customerReference: String!): [Account]
}

type Mutation {
    createAccount(input: AccountInput!): Account
    updateAccountStatus(id: ID!, status: AccountStatus!): Account
    debitAccount(id: ID!, amount: Float!): Account
    creditAccount(id: ID!, amount: Float!): Account
    deleteAccount(id: ID!): Boolean
}